# MetaTrader 5 Broker Integration Configuration

# Gemini API Key for AI Support
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application URL
APP_URL="MY_APP_URL"

# MT5 Broker Configuration Examples
# Format: BROKER_[BROKERNAME]_[SETTING]=value

# Primary Broker Configuration
BROKER_PRIMARY_CODE="EXNESS"
BROKER_PRIMARY_USERNAME="your_mt5_username"
BROKER_PRIMARY_PASSWORD="your_mt5_password"
BROKER_PRIMARY_ACCOUNT_NUMBER="your_account_number"
BROKER_PRIMARY_API_KEY="optional_api_key"
BROKER_PRIMARY_API_SECRET="optional_api_secret"
BROKER_PRIMARY_ACCOUNT_TYPE="real"

# Secondary Broker Configuration (Optional)
BROKER_SECONDARY_CODE="IC_MARKETS"
BROKER_SECONDARY_USERNAME="your_secondary_username"
BROKER_SECONDARY_PASSWORD="your_secondary_password"
BROKER_SECONDARY_ACCOUNT_NUMBER="your_secondary_account"
BROKER_SECONDARY_ACCOUNT_TYPE="real"

# Withdrawal Settings
WITHDRAWAL_MIN_AMOUNT="10"
WITHDRAWAL_MAX_AMOUNT="10000"
WITHDRAWAL_CURRENCY="USD"

# Mining Asset Settings
MINING_ASSET_NAME="HSC"
MINING_ASSET_MULTIPLIER="1.5"

# Database Configuration (Firebase)
FIREBASE_PROJECT_ID="your_project_id"
FIREBASE_API_KEY="your_firebase_api_key"
FIREBASE_AUTH_DOMAIN="your_auth_domain"

# Node Environment
NODE_ENV="development"
